@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix esaog: <https://w3id.org/esaog/core#> .
@prefix esh:   <https://w3id.org/esaog/shapes#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Registry shapes used by Algorithm A4 (controlled semantic registration).
esh:ActorRegistrationShape a sh:NodeShape ;
    sh:targetClass esaog:Actor ;
    sh:property [ sh:path esaog:hasCapability ; sh:minCount 1 ; sh:message "Actor must declare a capability" ] ;
    sh:property [ sh:path esaog:acceptsInput ; sh:minCount 1 ; sh:message "Actor must declare a typed input" ] ;
    sh:property [ sh:path esaog:producesOutput ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Actor must declare one output type" ] ;
    sh:property [ sh:path esaog:clearanceLevel ; sh:minCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path esaog:costPerCall ; sh:minCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path esaog:expectedLatency ; sh:minCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path esaog:hostedExternally ; sh:minCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path esaog:availableAs ; sh:minCount 1 ; sh:pattern "^mcp://" ] .
